{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "fareSettings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "fareSettingsHistory": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["email"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.child('status').val() === data.child('status').val()"
      }
    },

    "drivers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["email"],
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId && (!newData.exists() || ((newData.child('registrationStatus').val() === 'pending' || newData.child('registrationStatus').val() === data.child('registrationStatus').val()) && (newData.child('status').val() === 'pending' || newData.child('status').val() === data.child('status').val())))"
      }
    },

    "driver_locations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId"
      }
    },

    "driver_approvals": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["status"],
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        ".write": "auth != null && auth.uid === $driverId && (!newData.exists() || newData.child('status').val() === 'pending')"
      }
    },

    "driver_applications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "driverApplications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "applications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "bookings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["userId", "driverId", "status", "createdAt"],
      "$bookingId": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'pending' && (!newData.hasChild('driverId') || newData.child('driverId').val() === '')) || (data.exists() && data.child('userId').val() === auth.uid && newData.child('userId').val() === auth.uid && (newData.child('status').val() === data.child('status').val() || newData.child('status').val() === 'cancelled')) || (data.exists() && data.child('status').val() === 'pending' && (!data.hasChild('driverId') || data.child('driverId').val() === '') && newData.child('driverId').val() === auth.uid && newData.child('status').val() === 'accepted' && newData.child('userId').val() === data.child('userId').val()) || (data.exists() && data.child('driverId').val() === auth.uid && newData.child('driverId').val() === auth.uid && newData.child('userId').val() === data.child('userId').val()))",
        "rejectedBy": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "ratings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$driverId": {
        ".read": "auth != null",
        "$bookingId": {
          ".write": "auth != null && root.child('bookings').child($bookingId).child('userId').val() === auth.uid && root.child('bookings').child($bookingId).child('driverId').val() === $driverId"
        }
      }
    },

    "driver_commissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        "payment_deadline": {
          ".write": "auth != null && auth.uid === $driverId"
        }
      }
    },

    "commission_payment": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        "$paymentId": {
          ".write": "auth != null && auth.uid === $driverId && !data.exists() && newData.child('status').val() === 'pending'"
        }
      }
    },

    "commissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "user_notifications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        "$notificationId": {
          ".write": "auth != null && (auth.uid === $userId || (!data.exists() && newData.hasChild('bookingId') && root.child('bookings').child(newData.child('bookingId').val()).child('driverId').val() === auth.uid))"
        }
      }
    },

    "driver_notifications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        "$notificationId": {
          ".write": "auth != null && (auth.uid === $driverId || (!data.exists() && newData.hasChild('bookingId') && root.child('bookings').child(newData.child('bookingId').val()).child('userId').val() === auth.uid))"
        }
      }
    },

    "booking_chats": {
      "$bookingId": {
        ".read": "auth != null && (root.child('bookings').child($bookingId).child('userId').val() === auth.uid || root.child('bookings').child($bookingId).child('driverId').val() === auth.uid)",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.child('senderId').val() === auth.uid && (root.child('bookings').child($bookingId).child('userId').val() === auth.uid || root.child('bookings').child($bookingId).child('driverId').val() === auth.uid)"
          }
        }
      }
    }
  }
}
